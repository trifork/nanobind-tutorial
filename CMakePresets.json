{
	"version": 4,
	"cmakeMinimumRequired": {
		"major": 3,
		"minor": 23
	},
	"configurePresets": [
		{
			"name": "default",
			"hidden": true,
			"generator": "Ninja",
			"binaryDir": "${sourceDir}/cmake-build-${presetName}"
		},
		{
			"name": "debug",
			"inherits": "default",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Debug",
				"CMAKE_CXX_FLAGS": "-fsanitize=undefined",
				"BUILD_TESTS": "ON"
			}
		},
		{
			"name": "release",
			"inherits": "default",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Release"
			}
		},
		{
			"name": "nanobind",
			"inherits": "release",
			"toolchainFile": "${sourceDir}/cmake-build-nanobind/conan/build/Release/generators/conan_toolchain.cmake",
			"cacheVariables": {
				"SKBUILD": "ON"
			}
		}
	]
}
